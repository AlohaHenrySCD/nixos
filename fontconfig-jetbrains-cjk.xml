<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <alias binding="strong">
    <family>@ui@</family>
    <accept>
      <family>@uiCjk@</family>
    </accept>
  </alias>
  <alias binding="strong">
    <family>@monospace@</family>
    <accept>
      <family>@monospaceCjk@</family>
    </accept>
  </alias>
</fontconfig>
